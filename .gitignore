# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python (for tools/ and future scripts)
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ROS 2 (for future code)
build/
install/
log/
*.bag
*.db3

# ...but the docs build-package directory is documentation, not a ROS build dir
!docs/build/
!docs/build/**

# Secrets — never commit these
.env
.env.local
*.pem
*.key
*.crt
*credentials*

# Local tooling — machine-specific MCP server config (hardcoded local paths)
.mcp.json

# Blender auto-save backups (the live .blend is tracked via LFS; backups are not)
*.blend1
*.blend2
