<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>friday_phone_bridge</name>
  <version>0.1.0</version>
  <description>
    Phone sensor pod agent: bridges an Android phone's GPS (via gpsd) and IMU
    (HyperIMU UDP JSON) into /mark1/phone/fix and /mark1/phone/imu. Advisory
    only — outside the safety path. Module MARK1-PHONE-001.
  </description>
  <maintainer email="iamfriday86@gmail.com">Friday Labs Inc.</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>friday_msgs</depend>
  <depend>friday_module_agent</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
