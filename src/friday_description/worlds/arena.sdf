<?xml version="1.0"?>
<!--
  Mark 1 Stage 1 — uneven terrain to exercise the rocker-bogie. Flat start, then
  two transverse ridges (induce body PITCH) and one offset rock (induces body ROLL).
  Obstacle heights 0.040-0.050 m ≈ 0.55-0.7 x wheel radius (0.070) — climbable, but
  only if the suspension articulates. The body should stay far more level than a
  rigid chassis would, and never flip.
-->
<sdf version="1.10">
  <world name="arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- transverse ridge 1 (pitch) -->
    <model name="ridge_1">
      <static>true</static>
      <pose>0.75 0 0.020 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.09 1.40 0.040</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.09 1.40 0.040</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- transverse ridge 2 (pitch, taller) -->
    <model name="ridge_2">
      <static>true</static>
      <pose>1.25 0 0.0225 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.09 1.40 0.045</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.09 1.40 0.045</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- offset rock on the LEFT (induces body roll) -->
    <model name="rock_left">
      <static>true</static>
      <pose>1.75 0.28 0.025 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.14 0.14 0.050</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.14 0.14 0.050</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>


    <!-- ===== arena structure: lidar-visible (scan plane ~0.25 m) =====
         An 8x8 m walled yard with pillars: the bump-course stays for the
         suspension; the walls/pillars give SLAM and Nav2 something to see. -->
    <model name="wall_north"><static>true</static><pose>0 4 0.3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>8.2 0.1 0.6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8.2 0.1 0.6</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -4 0.3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>8.2 0.1 0.6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8.2 0.1 0.6</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>4 0 0.3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 8.2 0.6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 8.2 0.6</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-4 0 0.3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 8.2 0.6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 8.2 0.6</size></box></geometry></visual></link></model>
    <model name="pillar_1"><static>true</static><pose>2.2 1.8 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>-1.8 2.4 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></visual></link></model>
    <model name="pillar_3"><static>true</static><pose>-2.4 -1.6 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></visual></link></model>
    <model name="crate"><static>true</static><pose>1.4 -2.2 0.2 0 0 0.5</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></visual></link></model>
  </world>
</sdf>
