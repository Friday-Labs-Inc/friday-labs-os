<?xml version="1.0"?>
<!--
  Mark 1 — Stage 1 sim model (first-light).

  Geometry is measured directly from the scaled-Perseverance model
  (Mechanics/reference-models/perseverance/mark1_sim_spec.md), expressed in the
  ROS REP-103 frame: +X forward, +Y left, +Z up. Wheels spin about Y.

  First-light scope: a RIGID six-wheel chassis (wheels mounted straight to the
  body) so the sim pipeline is proven to spawn / stand / drive. The articulated
  rocker-bogie pivots (passive revolute rocker + bogie per side) are the next
  refinement — see the TODO at the bottom. Drive is skid/differential via
  gz_ros2_control + diff_drive_controller (left 3 wheels / right 3 wheels).
-->
<robot name="mark1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_yaml" default=""/>

  <!-- ===== measured parameters (metres / kg) ===== -->
  <xacro:property name="wheel_radius" value="0.070"/>
  <xacro:property name="wheel_width"  value="0.050"/>
  <xacro:property name="wheel_mass"   value="0.38"/>
  <xacro:property name="body_mass"    value="8.2"/>

  <!-- wheel centres in the base frame (axle plane = z 0) -->
  <xacro:property name="y_corner" value="0.291"/>   <!-- |y| of front/rear wheels -->
  <xacro:property name="y_mid"    value="0.323"/>   <!-- |y| of middle wheels (wider) -->
  <xacro:property name="x_front"  value="0.302"/>
  <xacro:property name="x_mid"    value="0.015"/>
  <xacro:property name="x_rear"   value="-0.302"/>

  <material name="body_mat"><color rgba="0.85 0.83 0.78 1.0"/></material>
  <material name="wheel_mat"><color rgba="0.15 0.15 0.17 1.0"/></material>

  <!-- ===== base / body ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0.05 0 0.251" rpy="0 0 0"/>
      <geometry><box size="0.555 0.413 0.220"/></geometry>
      <material name="body_mat"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0.251" rpy="0 0 0"/>
      <geometry><box size="0.555 0.413 0.220"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0.251" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.150" ixy="0" ixz="0" iyy="0.244" iyz="0" izz="0.327"/>
    </inertial>
  </link>

  <!-- ===== wheel macro (cylinder axis rotated to lie along Y) ===== -->
  <xacro:macro name="wheel" params="name x y">
    <link name="wheel_${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_mat"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000545" ixy="0" ixz="0" iyy="0.000931" iyz="0" izz="0.000545"/>
      </inertial>
    </link>
    <joint name="wheel_${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${name}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.10"/>
    </joint>
    <gazebo reference="wheel_${name}">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left_front"  x="${x_front}" y="${y_corner}"/>
  <xacro:wheel name="left_mid"    x="${x_mid}"   y="${y_mid}"/>
  <xacro:wheel name="left_rear"   x="${x_rear}"  y="${y_corner}"/>
  <xacro:wheel name="right_front" x="${x_front}" y="${-y_corner}"/>
  <xacro:wheel name="right_mid"   x="${x_mid}"   y="${-y_mid}"/>
  <xacro:wheel name="right_rear"  x="${x_rear}"  y="${-y_corner}"/>

  <!-- ===== ros2_control: a velocity interface on each of the 6 wheels ===== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="wheel_ctl" params="name">
      <joint name="wheel_${name}_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_ctl name="left_front"/>
    <xacro:wheel_ctl name="left_mid"/>
    <xacro:wheel_ctl name="left_rear"/>
    <xacro:wheel_ctl name="right_front"/>
    <xacro:wheel_ctl name="right_mid"/>
    <xacro:wheel_ctl name="right_rear"/>
  </ros2_control>

  <!-- ===== gz_ros2_control plugin: starts the controller_manager inside Gazebo ===== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <!--
    TODO (Stage 1 full): replace the rigid wheel mounts with the articulated
    rocker-bogie — per side: rocker (passive revolute, axis Y) carrying the front
    wheel + a bogie (passive revolute, axis Y) carrying the mid+rear wheels; add
    the cross-body differential. Then verify over uneven terrain.
  -->
</robot>
