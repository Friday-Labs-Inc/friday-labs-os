<?xml version="1.0"?>
<!--
  Mark 1 — Stage 1 sim model: articulated six-wheel ROCKER-BOGIE.

  Frame: ROS REP-103 (+X forward, +Y left, +Z up). Wheels spin about Y.
  Geometry measured from the scaled-Perseverance model
  (Mechanics/reference-models/perseverance/mark1_sim_spec.md). At zero suspension
  angle every wheel sits exactly at its measured (x, y) on the axle plane (z 0).

  Per side: a PASSIVE rocker (revolute, axis Y) pivots on the body and carries the
  front wheel + a PASSIVE bogie (revolute, axis Y); the bogie carries the mid and
  rear wheels. Pure passive damped joints (no springs) — the rocker-bogie levels by
  geometry + gravity, like the real rover. The 6 wheels are velocity-driven via
  gz_ros2_control + diff_drive_controller (skid steer, left 3 / right 3).

  Simplification (noted): the cross-body differential bar (a closed kinematic loop)
  is omitted — URDF is a tree. On flat/symmetric ground the body settles level; on
  rough ground it rolls slightly more than the real differential-coupled rover.
-->
<robot name="mark1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_yaml" default=""/>

  <!-- ===== measured parameters (m / kg) ===== -->
  <xacro:property name="wheel_radius" value="0.070"/>
  <xacro:property name="wheel_width"  value="0.050"/>
  <xacro:property name="wheel_mass"   value="0.38"/>
  <xacro:property name="body_mass"    value="6.0"/>
  <xacro:property name="rocker_mass"  value="0.7"/>
  <xacro:property name="bogie_mass"   value="0.4"/>

  <material name="body_mat"><color rgba="0.85 0.83 0.78 1.0"/></material>
  <material name="wheel_mat"><color rgba="0.15 0.15 0.17 1.0"/></material>
  <material name="arm_mat"><color rgba="0.55 0.55 0.58 1.0"/></material>

  <!-- ===== body ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0.05 0 0.251"/>
      <geometry><box size="0.555 0.413 0.220"/></geometry>
      <material name="body_mat"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0.251"/>
      <geometry><box size="0.555 0.413 0.220"/></geometry>
    </collision>
    <inertial>
      <!-- CoM kept LOW (z=0.18, below the rocker pivots at 0.28) for a stable,
           self-levelling sprung body — heavy components sit low in the real deck. -->
      <origin xyz="0.05 0 0.18"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.110" ixy="0" ixz="0" iyy="0.178" iyz="0" izz="0.239"/>
    </inertial>
  </link>

  <!-- ===== a driven wheel (cylinder axis rotated to lie along Y) ===== -->
  <xacro:macro name="wheel" params="name parent x y z">
    <link name="wheel_${name}">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_mat"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000545" ixy="0" ixz="0" iyy="0.000931" iyz="0" izz="0.000545"/>
      </inertial>
    </link>
    <joint name="wheel_${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="wheel_${name}"/>
      <origin xyz="${x} ${y} ${z}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.10"/>
    </joint>
    <gazebo reference="wheel_${name}">
      <mu1>1.2</mu1><mu2>1.2</mu2><kp>1e6</kp><kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ===== a passive suspension arm (rocker or bogie) ===== -->
  <xacro:macro name="arm" params="name parent x y z mass arm_len ixx iyy izz">
    <link name="${name}">
      <visual>
        <origin xyz="${arm_len/2 - 0.16} 0 -0.04"/>
        <geometry><box size="${arm_len} 0.03 0.03"/></geometry>
        <material name="arm_mat"/>
      </visual>
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.7" upper="0.7" effort="80" velocity="5"/>
      <dynamics damping="1.5" friction="0.3"/>
    </joint>
  </xacro:macro>

  <!-- ===== one side: rocker (front wheel) + bogie (mid + rear wheels) ===== -->
  <xacro:macro name="leg" params="side s">
    <!-- rocker pivot raised to z=0.28 (ABOVE the body CoM) so the sprung body
         hangs like a pendulum and self-levels; the arms still articulate over
         bumps but gravity recenters them. Wheels stay at their measured (x, y). -->
    <xacro:arm name="rocker_${side}" parent="base_link"
               x="0.0" y="${0.27*s}" z="0.28"
               mass="${rocker_mass}" arm_len="0.45" ixx="0.001" iyy="0.012" izz="0.012"/>
    <xacro:wheel name="${side}_front" parent="rocker_${side}"
                 x="0.302" y="${0.021*s}" z="-0.28"/>
    <xacro:arm name="bogie_${side}" parent="rocker_${side}"
               x="-0.14" y="${0.03*s}" z="-0.28"
               mass="${bogie_mass}" arm_len="0.32" ixx="0.0005" iyy="0.0035" izz="0.0035"/>
    <xacro:wheel name="${side}_mid" parent="bogie_${side}"
                 x="0.155" y="${0.023*s}" z="0.0"/>
    <xacro:wheel name="${side}_rear" parent="bogie_${side}"
                 x="-0.162" y="${-0.009*s}" z="0.0"/>
  </xacro:macro>

  <xacro:leg side="left"  s="1"/>
  <xacro:leg side="right" s="-1"/>

  <!-- ===== ros2_control: velocity interface on each of the 6 wheels ===== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="wheel_ctl" params="name">
      <joint name="wheel_${name}_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_ctl name="left_front"/>
    <xacro:wheel_ctl name="left_mid"/>
    <xacro:wheel_ctl name="left_rear"/>
    <xacro:wheel_ctl name="right_front"/>
    <xacro:wheel_ctl name="right_mid"/>
    <xacro:wheel_ctl name="right_rear"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <!-- publish ALL joint angles (incl. passive rocker/bogie) on a gz topic -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
