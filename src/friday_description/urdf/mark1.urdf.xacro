<?xml version="1.0"?>
<!--
  Mark 1 — Stage 1 sim model (clean rebuild): RIGID six-wheel chassis with a
  visually-correct rocker-bogie tube frame + ACKERMANN corner steering.

  Frame: ROS REP-103 (+X fwd, +Y left, +Z up). base_link sits at the axle plane
  (z=0); every wheel centre is at z=0, so all six rest flat on the ground at once
  (rigid → no tipping, no lifted wheel). Wheel positions and visual meshes are
  measured/exported from the HowToMechatronics replica CAD
  (Mechanics/.../Perseverance_Replica_Assembly.step) — see docs/build/MK1_Body_Anatomy.md.

  Steering: the 4 CORNER wheels steer about a vertical (Z) axis (Ackermann); the 2
  MIDDLE wheels are drive-only. All 6 wheels are velocity-driven. This replaces the
  earlier passive-articulated + skid-steer model, which tipped on turns and didn't
  sit flat. (Articulated rocker-bogie flex is a later feature on top of this.)
-->
<robot name="mark1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_yaml" default=""/>

  <!-- ===== measured parameters (m / kg) ===== -->
  <xacro:property name="wheel_radius" value="0.0668"/> <!-- tire OD 133.6 mm, measured from replica CAD -->

  <xacro:property name="wheel_width"  value="0.0866"/>
  <xacro:property name="wheel_mass"   value="0.35"/>
  <xacro:property name="body_mass"    value="8.4"/>
  <xacro:property name="arm_r"        value="0.012"/>

  <material name="body_mat"><color rgba="0.85 0.83 0.78 1.0"/></material>
  <material name="wheel_mat"><color rgba="0.13 0.13 0.15 1.0"/></material>
  <material name="arm_mat"><color rgba="0.55 0.55 0.58 1.0"/></material>

  <!-- ===== base / body (rigid: body box + both side tube frames) ===== -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://friday_description/meshes/chassis.stl"/></geometry>
      <material name="body_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.251"/>
      <geometry><box size="0.555 0.413 0.220"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.251"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.153" ixy="0" ixz="0" iyy="0.249" iyz="0" izz="0.335"/>
    </inertial>
  </link>

  <!-- ===== a wheel link (cylinder axis along Y) ===== -->
  <xacro:macro name="wheel_link" params="name">
    <link name="wheel_${name}">
      <visual>
        <geometry><mesh filename="package://friday_description/meshes/wheel.stl"/></geometry>
        <material name="wheel_mat"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00086" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
    <gazebo reference="wheel_${name}">
      <mu1>1.2</mu1><mu2>1.2</mu2><kp>1e6</kp><kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ===== corner wheel: steering knuckle (revolute Z) + driven wheel ===== -->
  <xacro:macro name="corner" params="name x y knuckle">
    <link name="${name}_steer">
      <visual><geometry><mesh filename="package://friday_description/meshes/${knuckle}.stl"/></geometry><material name="arm_mat"/></visual>
      <inertial><mass value="0.1"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    </link>
    <joint name="${name}_steer_joint" type="revolute">
      <parent link="base_link"/><child link="${name}_steer"/>
      <origin xyz="${x} ${y} 0"/><axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="50" velocity="6"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
    <xacro:wheel_link name="${name}"/>
    <joint name="wheel_${name}_joint" type="continuous">
      <parent link="${name}_steer"/><child link="wheel_${name}"/>
      <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
      <dynamics damping="0.05"/>
    </joint>
  </xacro:macro>

  <!-- ===== middle wheel: drive-only (no steer) ===== -->
  <xacro:macro name="mid" params="name x y">
    <xacro:wheel_link name="${name}"/>
    <joint name="wheel_${name}_joint" type="continuous">
      <parent link="base_link"/><child link="wheel_${name}"/>
      <origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/>
      <dynamics damping="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:corner name="left_front"  x="0.290"  y="0.268"  knuckle="knuckle_fl"/>
  <xacro:corner name="left_rear"   x="-0.290" y="0.268"  knuckle="knuckle_fl"/>
  <xacro:corner name="right_front" x="0.290"  y="-0.268" knuckle="knuckle_fr"/>
  <xacro:corner name="right_rear"  x="-0.290" y="-0.268" knuckle="knuckle_fr"/>
  <xacro:mid    name="left_mid"    x="-0.011" y="0.301"/>
  <xacro:mid    name="right_mid"   x="-0.011" y="-0.301"/>

  <!-- ===== ros2_control: 6 wheels (velocity) + 4 steer (position) ===== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="drive_jt" params="name">
      <joint name="wheel_${name}_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:macro name="steer_jt" params="name">
      <joint name="${name}_steer_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
    </xacro:macro>
    <xacro:drive_jt name="left_front"/>
    <xacro:drive_jt name="left_mid"/>
    <xacro:drive_jt name="left_rear"/>
    <xacro:drive_jt name="right_front"/>
    <xacro:drive_jt name="right_mid"/>
    <xacro:drive_jt name="right_rear"/>
    <xacro:steer_jt name="left_front"/>
    <xacro:steer_jt name="left_rear"/>
    <xacro:steer_jt name="right_front"/>
    <xacro:steer_jt name="right_rear"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <!-- ================= Phase-0 senses (sim) ==================
       A 2D lidar and an IMU so the autonomy stack (EKF -> SLAM -> Nav2) has
       real inputs. Sim stand-ins for the future Research-Deck lidar and the
       Drive board's BNO085: same topics, same frames: hardware arrival is a
       publisher swap, not a rewrite. -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry></visual>
    <inertial><mass value="0.1"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <!-- mast-head mount (the replica's camera mast carries Mark 1's sensors):
         above the whole body mesh, so the lidar never sees its own chassis.
         At the old 0.25 height the real body boxed the scan in — 2720
         self-return triangles -> costmap lethal ring -> Nav2 could not plan. -->
    <origin xyz="0.193 -0.101 0.57" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial><mass value="0.02"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
</robot>
