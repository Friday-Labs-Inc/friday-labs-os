<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>friday_core_hub</name>
  <version>0.1.0</version>
  <description>
    Core Compute Hub orchestration spine for Friday Labs OS: module-registry,
    a lite health monitor, and a Nav2-style lifecycle supervisor that brings
    managed module nodes up deterministically.
  </description>
  <maintainer email="iamfriday86@gmail.com">Friday Labs Inc.</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>friday_msgs</depend>
  <depend>friday_module_agent</depend>
  <depend>lifecycle_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
